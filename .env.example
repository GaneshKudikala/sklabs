# Set these as Cloudflare Pages environment variables (never commit real values).
# Used by functions/api/contact.ts. For local function testing copy .dev.vars.example to .dev.vars.
RESEND_API_KEY=
TURNSTILE_SECRET=
CONTACT_TO_EMAIL=
# Optional: verified Resend sender (default "SK LABS <noreply@sklabs.nl>")
CONTACT_FROM_EMAIL=
# Public, build-time Turnstile site key. Local testing: 1x00000000000000000000AA always passes.
PUBLIC_TURNSTILE_SITE_KEY=
