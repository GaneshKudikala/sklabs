---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="max-w-3xl divide-y divide-ink-950/10 border-y border-ink-950/10">
  {items.map((f) => (
    <details class="group py-4">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-ink-950 marker:content-none">
        <span>{f.q}</span>
        <span
          aria-hidden="true"
          class="mt-0.5 shrink-0 text-accent-600 transition group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <p class="mt-3 text-ink-700">{f.a}</p>
    </details>
  ))}
</div>
