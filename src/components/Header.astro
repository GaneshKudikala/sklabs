---
import Wordmark from './Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  pathname: string;
  showWork?: boolean;
}
const { lang, pathname, showWork = false } = Astro.props;
const t = useT(lang);

const links = [
  { href: localePath(lang, 'services'), label: t.nav.services },
  { href: localePath(lang, 'products'), label: t.nav.products },
  ...(showWork ? [{ href: localePath(lang, 'work'), label: t.nav.work }] : []),
  { href: localePath(lang, 'about'), label: t.nav.about },
  { href: localePath(lang, 'insights'), label: t.nav.insights },
  { href: localePath(lang, 'contact'), label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-ink-950/10 bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={localePath(lang)} class="text-ink-950" aria-label="SK LABS">
      <Wordmark />
    </a>

    <nav aria-label={t.nav.main} class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={pathname.startsWith(l.href) ? 'page' : undefined}
          class="text-sm text-ink-700 transition-colors hover:text-ink-950 aria-[current=page]:text-ink-950"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} pathname={pathname} />
      <a
        href={localePath(lang, 'contact')}
        class="hidden rounded-md bg-accent-400 px-4 py-2 text-sm font-semibold text-ink-950 transition-colors hover:bg-accent-500 sm:inline-block"
      >
        {t.nav.bookCall}
      </a>

      <details class="relative md:hidden">
        <summary class="flex h-10 cursor-pointer list-none items-center rounded-md border border-ink-950/15 px-3 text-sm text-ink-950">
          {t.nav.menu}
        </summary>
        <nav
          aria-label={t.nav.main}
          class="absolute right-0 mt-2 w-56 rounded-lg border border-ink-950/10 bg-white p-2 shadow-xl"
        >
          {links.map((l) => (
            <a
              href={l.href}
              class="block rounded-md px-3 py-2 text-sm text-ink-950 hover:bg-ink-950/5"
            >
              {l.label}
            </a>
          ))}
          <a
            href={localePath(lang, 'contact')}
            class="mt-1 block rounded-md bg-accent-400 px-3 py-2 text-center text-sm font-semibold text-ink-950"
          >
            {t.nav.bookCall}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
