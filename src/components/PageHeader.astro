---
interface Props {
  title: string;
  lead?: string;
  draftNotice?: string;
}
const { title, lead, draftNotice } = Astro.props;
---

<div class="bg-grid">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-ink-950 sm:text-5xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-ink-700">{lead}</p>}
    {draftNotice && (
      <p class="mt-4 inline-block rounded bg-accent-400/25 px-3 py-1 text-xs font-semibold text-accent-600">
        {draftNotice}
      </p>
    )}
  </div>
</div>
