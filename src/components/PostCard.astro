---
import { localePath, type Lang } from '../i18n';
interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  readMore: string;
}
const { lang, slug, title, description, date, readMore } = Astro.props;
const fmt = date.toLocaleDateString(lang === 'nl' ? 'nl-NL' : 'en-GB', { dateStyle: 'long' });
---

<article class="rounded-xl border border-ink-950/10 bg-white p-6 transition hover:border-accent-500 hover:shadow-md">
  <time
    datetime={date.toISOString()}
    class="text-xs font-semibold uppercase tracking-wider text-ink-500"
  >
    {fmt}
  </time>
  <h2 class="mt-2 text-xl font-semibold text-ink-950">
    <a href={localePath(lang, `insights/${slug}`)} class="hover:text-accent-600">
      {title}
    </a>
  </h2>
  <p class="mt-2 text-ink-700">{description}</p>
  <a
    href={localePath(lang, `insights/${slug}`)}
    class="mt-4 inline-block text-sm font-semibold text-accent-600"
  >
    {readMore} →
  </a>
</article>
