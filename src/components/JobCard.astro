---
import { formatSalary } from '../i18n/content';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
  d: {
    title: string;
    summary: string;
    location: string;
    workModel: string;
    employmentType: string;
    seniority: string;
    specialism: string[];
    tags: string[];
    clientDescriptor: string;
    sample: boolean;
    salaryMin: number;
    salaryMax: number;
    currency: string;
    salaryPeriod: string;
  };
  filterable?: boolean;
}
const { lang, slug, d, filterable = false } = Astro.props;
const j = useT(lang).jobs;
const search = [d.title, d.summary, d.location, d.clientDescriptor, ...d.tags, ...d.specialism]
  .join(' ')
  .toLowerCase();
const data = filterable
  ? {
      'data-job': '',
      'data-search': search,
      'data-location': d.location,
      'data-work': d.workModel,
      'data-type': d.employmentType,
      'data-specialism': d.specialism.join(' '),
      'data-seniority': d.seniority,
    }
  : {};
---

<li {...data}>
  <a
    href={localePath(lang, `jobs/${slug}`)}
    class="block h-full rounded-xl border border-ink-950/10 bg-white p-6 transition hover:border-accent-500 hover:shadow-md"
  >
    <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
      {j.types[d.employmentType as keyof typeof j.types]} ·{' '}
      {j.modes[d.workModel as keyof typeof j.modes]} ·{' '}
      {j.levels[d.seniority as keyof typeof j.levels]}
      {d.sample && (
        <span class="ml-2 rounded bg-accent-400/25 px-2 py-0.5 text-accent-600">{j.sample}</span>
      )}
    </p>
    <h3 class="mt-2 text-xl font-semibold text-ink-950">{d.title}</h3>
    <p class="mt-1 text-sm text-ink-500">
      {d.clientDescriptor} · {d.location}
    </p>
    <p class="mt-3 text-ink-700">{d.summary}</p>
    <p class="mt-3 text-sm font-semibold text-ink-950">{formatSalary(d, lang, j.per)}</p>
    <span class="mt-4 inline-block text-sm font-semibold text-accent-600">{j.readMore} →</span>
  </a>
</li>
