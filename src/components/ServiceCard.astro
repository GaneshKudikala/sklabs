---
import Icon from './Icon.astro';
interface Props {
  href: string;
  title: string;
  summary: string;
  icon: string;
  cta: string;
}
const { href, title, summary, icon, cta } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-xl border border-ink-950/10 bg-white p-6 transition hover:border-accent-500 hover:shadow-md"
>
  <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent-400/20 text-accent-600">
    <Icon name={icon} />
  </span>
  <h3 class="mt-5 text-lg font-semibold text-ink-950">{title}</h3>
  <p class="mt-2 flex-1 text-sm text-ink-700">{summary}</p>
  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent-600">
    {cta} <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
  </span>
</a>
