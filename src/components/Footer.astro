---
import Wordmark from './Wordmark.astro';
import { localePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  showWork?: boolean;
}
const { lang, showWork = false } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();

const company = [
  { href: localePath(lang, 'services'), label: t.nav.services },
  { href: localePath(lang, 'products'), label: t.nav.products },
  ...(showWork ? [{ href: localePath(lang, 'work'), label: t.nav.work }] : []),
  { href: localePath(lang, 'about'), label: t.nav.about },
  { href: localePath(lang, 'insights'), label: t.nav.insights },
  { href: localePath(lang, 'contact'), label: t.nav.contact },
];
const legal = [
  { href: localePath(lang, 'legal/privacy'), label: t.footer.privacy },
  { href: localePath(lang, 'legal/cookies'), label: t.footer.cookies },
  { href: localePath(lang, 'legal/terms'), label: t.footer.terms },
  { href: localePath(lang, 'legal/imprint'), label: t.footer.imprint },
];
---

<footer class="border-t border-ink-950/10 bg-ink-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <a href={localePath(lang)} class="text-ink-950" aria-label="SK LABS">
        <Wordmark />
      </a>
      <p class="mt-4 max-w-sm text-sm text-ink-700">{t.footer.tagline}</p>
    </div>
    <nav aria-label={t.footer.company}>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">
        {t.footer.company}
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {company.map((l) => (
          <li>
            <a class="text-ink-700 hover:text-ink-950" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.footer.legal}>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">{t.footer.legal}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {legal.map((l) => (
          <li>
            <a class="text-ink-700 hover:text-ink-950" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-ink-950/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-ink-500 sm:flex-row sm:justify-between sm:px-6">
      <p>
        © {year} SK LABS. {t.footer.rights}
      </p>
      <p>{t.footer.analytics}</p>
    </div>
  </div>
</footer>
