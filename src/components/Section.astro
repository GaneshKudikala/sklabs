---
interface Props {
  id?: string;
  tone?: 'default' | 'muted';
  title?: string;
  lead?: string;
}
const { id, tone = 'default', title, lead } = Astro.props;
---

<section id={id} class:list={['py-16 sm:py-20', tone === 'muted' && 'bg-ink-100']}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {(title || lead) && (
      <div class="mb-10 max-w-2xl">
        {title && (
          <h2 class="text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl">{title}</h2>
        )}
        {lead && <p class="mt-3 text-lg text-ink-700">{lead}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
