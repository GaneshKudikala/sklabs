---
interface Props {
  title: string;
  body: string;
  button: string;
  href: string;
}
const { title, body, button, href } = Astro.props;
---

<section class="bg-ink-950">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">{title}</h2>
      <p class="mt-3 text-ink-300">{body}</p>
    </div>
    <a
      href={href}
      class="inline-block self-start rounded-md bg-accent-400 px-6 py-3 font-semibold text-ink-950 hover:bg-accent-500 md:self-auto"
    >
      {button}
    </a>
  </div>
</section>
