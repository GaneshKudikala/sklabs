---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import { useT, type Lang } from '../i18n';
import { ogSlug } from '../lib/og';
import { getCaseStudies } from '../i18n/content';
import { organization } from '../lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  schema?: object[];
  ogType?: 'website' | 'article';
  published?: Date;
  /** Override the OG image slug (used by pages outside the OG registry, like 404). */
  ogImageSlug?: string;
}
const { lang, title, description, schema = [], ogType, published, ogImageSlug } = Astro.props;
const t = useT(lang);
const pathname = Astro.url.pathname;
const site = Astro.site ?? new URL('https://sklabs.nl');
const image = new URL(`/og/${lang}/${ogImageSlug ?? ogSlug(pathname)}.png`, site).href;
const fullTitle = title === t.meta.siteName ? title : `${title} | ${t.meta.siteName}`;
const showWork = (await getCaseStudies(lang)).length > 0;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO
      title={fullTitle}
      description={description ?? t.meta.defaultDescription}
      lang={lang}
      pathname={pathname}
      image={image}
      ogType={ogType}
      published={published}
    />
    <JsonLd data={[organization(), ...schema]} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      {t.nav.skip}
    </a>
    <Header lang={lang} pathname={pathname} showWork={showWork} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} showWork={showWork} />
  </body>
</html>
