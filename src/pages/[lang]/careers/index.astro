---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getStaticLangPaths, localePath, useT, type Lang } from '../../../i18n';
import { getJobs } from '../../../i18n/content';
import { breadcrumbs } from '../../../lib/schema';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const c = t.careers;
const jobs = await getJobs(lang);
const site = Astro.site!.origin;
const spontaneous = `${localePath(lang, 'contact')}?job=open-application&title=${encodeURIComponent(c.applySpontaneous)}&prefix=${encodeURIComponent(c.applyPrefix)}`;
---

<BaseLayout
  lang={lang}
  title={c.title}
  description={c.description}
  schema={[
    breadcrumbs([
      { name: 'SK LABS', url: `${site}/${lang}/` },
      { name: c.title, url: `${site}${localePath(lang, 'careers')}` },
    ]),
  ]}
>
  <PageHeader title={c.title} lead={c.lead} />
  <Section title={c.introTitle}>
    <p class="max-w-3xl text-lg text-ink-700">{c.intro}</p>
  </Section>
  <Section tone="muted" id="positions" title={c.openTitle}>
    {jobs.length === 0 ? (
      <p class="max-w-2xl text-ink-700">{c.empty}</p>
    ) : (
      <ul class="grid gap-5 md:grid-cols-2">
        {jobs.map((j) => (
          <li>
            <a
              href={localePath(lang, `careers/${j.slug}`)}
              class="block h-full rounded-xl border border-ink-950/10 bg-white p-6 transition hover:border-accent-500 hover:shadow-md"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
                {c.types[j.data.employmentType]} · {c.modes[j.data.workMode]}
              </p>
              <h3 class="mt-2 text-xl font-semibold text-ink-950">{j.data.title}</h3>
              <p class="mt-1 text-sm text-ink-500">{j.data.location}</p>
              <p class="mt-3 text-ink-700">{j.data.summary}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-accent-600">
                {c.readMore} →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
  <CtaBand
    title={c.spontaneousTitle}
    body={c.spontaneousBody}
    button={c.applySpontaneous}
    href={spontaneous}
  />
</BaseLayout>
