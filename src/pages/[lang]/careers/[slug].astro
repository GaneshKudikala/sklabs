---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getJobs } from '../../../i18n/content';
import { breadcrumbs, jobPosting } from '../../../lib/schema';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales)
    for (const j of await getJobs(lang))
      paths.push({ params: { lang, slug: j.slug }, props: { entry: j } });
  return paths;
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const c = t.careers;
const d = entry.data;
const site = Astro.site!.origin;
const url = `${site}${localePath(lang, `careers/${entry.slug}`)}`;
const fmt = d.posted.toLocaleDateString(lang === 'nl' ? 'nl-NL' : 'en-GB', { dateStyle: 'long' });
const applyHref = `${localePath(lang, 'contact')}?job=${encodeURIComponent(entry.slug)}&title=${encodeURIComponent(d.title)}&prefix=${encodeURIComponent(c.applyPrefix)}`;
const posting = jobPosting({
  title: d.title,
  description: `<p>${d.summary}</p><ul>${[...d.responsibilities, ...d.requirements].map((x) => `<li>${x}</li>`).join('')}</ul>`,
  url,
  location: d.location,
  workMode: d.workMode,
  employmentType: d.employmentType,
  posted: d.posted,
  validThrough: d.validThrough,
  lang,
});
const lists = [
  { title: c.responsibilities, items: d.responsibilities },
  { title: c.requirements, items: d.requirements },
  ...(d.niceToHave.length ? [{ title: c.niceToHave, items: d.niceToHave }] : []),
];
const facts = [
  [c.location, d.location],
  [c.workMode, c.modes[d.workMode]],
  [c.type, c.types[d.employmentType]],
  ...(d.level ? [[c.level, d.level]] : []),
  ...(d.compensation ? [[c.compensation, d.compensation]] : []),
  [c.posted, fmt],
];
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.summary}
  schema={[
    ...(posting ? [posting] : []),
    breadcrumbs([
      { name: 'SK LABS', url: `${site}/${lang}/` },
      { name: c.title, url: `${site}${localePath(lang, 'careers')}` },
      { name: d.title, url },
    ]),
  ]}
>
  <PageHeader
    title={d.title}
    lead={d.summary}
    draftNotice={d.draft ? t.services.draftNotice : undefined}
  />
  <Section>
    <a href={localePath(lang, 'careers')} class="text-sm font-semibold text-accent-600">
      ← {c.back}
    </a>
    <dl class="mt-6 grid max-w-3xl grid-cols-2 gap-4 text-sm sm:grid-cols-3">
      {facts.map(([k, v]) => (
        <div>
          <dt class="text-ink-500">{k}</dt>
          <dd class="font-semibold text-ink-950">{v}</dd>
        </div>
      ))}
    </dl>
    {lists.map((l) => (
      <>
        <h2 class="mt-10 text-2xl font-bold text-ink-950">{l.title}</h2>
        <ul class="mt-4 grid gap-3 md:grid-cols-2">
          {l.items.map((i) => (
            <li class="flex gap-3 text-ink-700">
              <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
              {i}
            </li>
          ))}
        </ul>
      </>
    ))}
    {d.skills.length > 0 && (
      <>
        <h2 class="mt-10 text-2xl font-bold text-ink-950">{c.skills}</h2>
        <p class="mt-4 flex flex-wrap gap-2">
          {d.skills.map((s) => (
            <span class="rounded-full border border-ink-950/15 px-3 py-1 text-sm text-ink-700">
              {s}
            </span>
          ))}
        </p>
      </>
    )}
  </Section>
  <CtaBand title={c.apply} body={c.applyBody} button={c.apply} href={applyHref} />
</BaseLayout>
