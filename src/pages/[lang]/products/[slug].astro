---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getProducts } from '../../../i18n/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    for (const p of await getProducts(lang))
      paths.push({ params: { lang, slug: p.slug }, props: { entry: p } });
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const d = entry.data;
const statusLabel = {
  live: t.products.statusLive,
  beta: t.products.statusBeta,
  'coming-soon': t.products.statusSoon,
};
---

<BaseLayout lang={lang} title={d.name} description={d.tagline}>
  <PageHeader
    title={d.name}
    lead={d.tagline}
    draftNotice={d.draft ? t.products.draftNotice : undefined}
  />
  <Section>
    <a href={localePath(lang, 'products')} class="text-sm font-semibold text-accent-600">
      ← {t.products.back}
    </a>
    <p class="mt-4">
      <span class="inline-block rounded-full bg-accent-400/25 px-3 py-1 text-xs font-semibold text-accent-600">
        {statusLabel[d.status]}
      </span>
    </p>
    <h2 class="mt-8 text-2xl font-bold text-ink-950">{t.products.problem}</h2>
    <p class="mt-3 max-w-3xl text-lg text-ink-700">{d.problem}</p>
    <h2 class="mt-10 text-2xl font-bold text-ink-950">{t.products.features}</h2>
    <ul class="mt-4 grid gap-3 md:grid-cols-2">
      {d.features.map((f) => (
        <li class="flex gap-3 text-ink-700">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          {f}
        </li>
      ))}
    </ul>
    {d.url && (
      <a
        href={d.url}
        rel="noopener"
        class="mt-8 inline-block rounded-md bg-accent-400 px-6 py-3 font-semibold text-ink-950 hover:bg-accent-500"
      >
        {t.products.visit}
      </a>
    )}
  </Section>
  <CtaBand
    title={t.products.notify}
    body={t.products.notifyBody}
    button={t.home.ctaButton}
    href={localePath(lang, 'contact')}
  />
</BaseLayout>
