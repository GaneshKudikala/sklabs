---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Prose from '../../../components/Prose.astro';
import { locales, useT, type Lang } from '../../../i18n';
import { getPage } from '../../../i18n/content';

export function getStaticPaths() {
  const slugs = ['privacy', 'cookies', 'terms', 'imprint'];
  return locales.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}
const { lang: l, slug } = Astro.params;
const lang = l as Lang;
const t = useT(lang);
const page = (await getPage(lang, `legal/${slug}`))!;
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <PageHeader
    title={page.data.title}
    draftNotice={page.data.draft ? t.services.draftNotice : undefined}
  />
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    {page.data.updated && (
      <p class="mb-6 text-sm text-ink-500">
        {t.legalUpdated}: {page.data.updated}
      </p>
    )}
    <Prose>
      <Content />
    </Prose>
  </div>
</BaseLayout>
