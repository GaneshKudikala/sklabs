---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getServices } from '../../../i18n/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    for (const s of await getServices(lang))
      paths.push({ params: { lang, slug: s.slug }, props: { entry: s } });
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const d = entry.data;
const models = [
  { label: t.services.assessment, body: d.engagement.assessment },
  { label: t.services.project, body: d.engagement.project },
  { label: t.services.retainer, body: d.engagement.retainer },
];
---

<BaseLayout lang={lang} title={d.seoTitle ?? d.title} description={d.seoDescription}>
  <div class="bg-grid">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <a href={localePath(lang, 'services')} class="text-sm font-semibold text-accent-600">
        ← {t.services.all}
      </a>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink-950 sm:text-5xl">
        {d.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-700">{d.summary}</p>
      {d.draft && (
        <p class="mt-4 inline-block rounded bg-accent-400/25 px-3 py-1 text-xs font-semibold text-accent-600">
          {t.services.draftNotice}
        </p>
      )}
    </div>
  </div>

  <Section title={t.services.problem}>
    <p class="max-w-3xl text-lg text-ink-700">{d.problem}</p>
  </Section>

  <Section tone="muted" title={t.services.whatWeDo}>
    <ul class="grid gap-4 md:grid-cols-2">
      {d.whatWeDo.map((i) => (
        <li class="flex gap-3 rounded-lg border border-ink-950/10 bg-white p-4 text-ink-700">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          {i}
        </li>
      ))}
    </ul>
  </Section>

  <Section title={t.services.deliverables}>
    <ul class="grid gap-3 md:grid-cols-2">
      {d.deliverables.map((i) => (
        <li class="flex gap-3 text-ink-700">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          {i}
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="muted" title={t.services.engagement}>
    <div class="grid gap-5 md:grid-cols-3">
      {models.map((m) => (
        <div class="rounded-xl border border-ink-950/10 bg-white p-6">
          <h3 class="font-semibold text-ink-950">{m.label}</h3>
          <p class="mt-2 text-sm text-ink-700">{m.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section title={t.services.faq}>
    <div class="max-w-3xl divide-y divide-ink-950/10 border-y border-ink-950/10">
      {d.faq.map((f) => (
        <details class="group py-4">
          <summary class="cursor-pointer list-none font-semibold text-ink-950">{f.q}</summary>
          <p class="mt-2 text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <CtaBand
    title={t.services.ctaTitle}
    body={t.services.ctaBody}
    button={t.services.ctaButton}
    href={localePath(lang, 'contact')}
  />
</BaseLayout>
