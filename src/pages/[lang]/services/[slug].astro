---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import FaqList from '../../../components/FaqList.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getServices } from '../../../i18n/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    for (const s of await getServices(lang))
      paths.push({ params: { lang, slug: s.slug }, props: { entry: s } });
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const d = entry.data;
const site = Astro.site!.origin;
const url = `${site}${localePath(lang, `services/${entry.slug}`)}`;
const models = [
  { label: t.services.assessment, body: d.engagement.assessment },
  { label: t.services.project, body: d.engagement.project },
  { label: t.services.retainer, body: d.engagement.retainer },
];
import { breadcrumbs, faqPage, service } from '../../../lib/schema';
---

<BaseLayout
  lang={lang}
  title={d.seoTitle ?? d.title}
  description={d.seoDescription}
  schema={[
    service(d.title, d.seoDescription, url),
    faqPage(d.faq),
    breadcrumbs([
      { name: 'SK LABS', url: `${site}/${lang}/` },
      { name: t.services.title, url: `${site}${localePath(lang, 'services')}` },
      { name: d.title, url },
    ]),
  ]}
>
  <div class="bg-grid">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <a href={localePath(lang, 'services')} class="text-sm font-semibold text-accent-600">
        ← {t.services.all}
      </a>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink-950 sm:text-5xl">
        {d.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-700">{d.summary}</p>
      {d.draft && (
        <p class="mt-4 inline-block rounded bg-accent-400/25 px-3 py-1 text-xs font-semibold text-accent-600">
          {t.services.draftNotice}
        </p>
      )}
    </div>
  </div>

  <Section title={t.services.achieve}>
    <div class="grid gap-5 md:grid-cols-2">
      {d.achieve.map((g) => (
        <div class="rounded-xl border border-ink-950/10 bg-white p-6">
          <h3 class="border-l-4 border-accent-400 pl-3 text-lg font-semibold text-ink-950">
            {g.title}
          </h3>
          <ul class="mt-4 space-y-3">
            {g.points.map((point) => (
              <li class="flex gap-3 text-ink-700">
                <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="muted" title={t.services.outcomes}>
    <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {d.outcomes.map((o, i) => (
        <li class="rounded-xl border border-ink-950/10 bg-white p-6">
          <span class="font-mono text-2xl font-bold text-accent-600">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-lg font-semibold text-ink-950">{o.title}</h3>
          <p class="mt-2 text-sm text-ink-700">{o.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section title={t.services.engagement}>
    <div class="grid gap-5 md:grid-cols-3">
      {models.map((m) => (
        <div class="rounded-xl border border-ink-950/10 bg-white p-6">
          <h3 class="font-semibold text-ink-950">{m.label}</h3>
          <p class="mt-2 text-sm text-ink-700">{m.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="muted" title={t.services.faq}>
    <FaqList items={d.faq} />
    <p class="mt-6">
      <a href={localePath(lang, 'faq')} class="text-sm font-semibold text-accent-600">
        {t.faq.more} →
      </a>
    </p>
  </Section>

  <CtaBand
    title={d.cta.title}
    body={d.cta.body}
    button={t.services.ctaButton}
    href={localePath(lang, 'contact')}
  />
</BaseLayout>
