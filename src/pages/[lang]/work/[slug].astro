---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getCaseStudies } from '../../../i18n/content';
import { breadcrumbs } from '../../../lib/schema';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales)
    for (const c of await getCaseStudies(lang))
      paths.push({ params: { lang, slug: c.slug }, props: { entry: c } });
  return paths;
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const d = entry.data;
const site = Astro.site!.origin;
const url = `${site}${localePath(lang, `work/${entry.slug}`)}`;
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.summary}
  schema={[
    breadcrumbs([
      { name: 'SK LABS', url: `${site}/${lang}/` },
      { name: t.work.title, url: `${site}${localePath(lang, 'work')}` },
      { name: d.title, url },
    ]),
  ]}
>
  <PageHeader
    title={d.title}
    lead={d.summary}
    draftNotice={d.draft ? t.services.draftNotice : undefined}
  />
  <Section>
    <a href={localePath(lang, 'work')} class="text-sm font-semibold text-accent-600">
      ← {t.work.back}
    </a>
    <dl class="mt-6 grid max-w-xl grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-ink-500">{t.work.client}</dt>
        <dd class="font-semibold text-ink-950">{d.client}</dd>
      </div>
      <div>
        <dt class="text-ink-500">{t.work.sector}</dt>
        <dd class="font-semibold text-ink-950">{d.sector}</dd>
      </div>
    </dl>
    <h2 class="mt-10 text-2xl font-bold text-ink-950">{t.work.challenge}</h2>
    <p class="mt-3 max-w-3xl text-lg text-ink-700">{d.challenge}</p>
    <h2 class="mt-10 text-2xl font-bold text-ink-950">{t.work.solution}</h2>
    <p class="mt-3 max-w-3xl text-lg text-ink-700">{d.solution}</p>
    <h2 class="mt-10 text-2xl font-bold text-ink-950">{t.work.outcomes}</h2>
    <ul class="mt-4 grid gap-3 md:grid-cols-2">
      {d.outcomes.map((o) => (
        <li class="flex gap-3 text-ink-700">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
          {o}
        </li>
      ))}
    </ul>
  </Section>
  <CtaBand
    title={t.home.ctaTitle}
    body={t.home.ctaBody}
    button={t.home.ctaButton}
    href={localePath(lang, 'contact')}
  />
</BaseLayout>
