---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import { locales, localePath, useT, type Lang } from '../../../i18n';
import { getCaseStudies } from '../../../i18n/content';

// Only built for languages that have case studies, so the section stays invisible until you add one.
export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales)
    if ((await getCaseStudies(lang)).length) paths.push({ params: { lang } });
  return paths;
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const items = await getCaseStudies(lang);
---

<BaseLayout lang={lang} title={t.work.title} description={t.work.description}>
  <PageHeader title={t.work.title} lead={t.work.lead} />
  <Section>
    <div class="grid gap-5 md:grid-cols-2">
      {items.map((c) => (
        <a
          href={localePath(lang, `work/${c.slug}`)}
          class="rounded-xl border border-ink-950/10 bg-white p-6 transition hover:border-accent-500 hover:shadow-md"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">{c.data.sector}</p>
          <h2 class="mt-2 text-xl font-semibold text-ink-950">{c.data.title}</h2>
          <p class="mt-2 text-ink-700">{c.data.summary}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-accent-600">
            {t.work.readMore} →
          </span>
        </a>
      ))}
    </div>
  </Section>
</BaseLayout>
